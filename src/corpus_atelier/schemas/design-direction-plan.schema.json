{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "planning_mode": {
      "type": "string",
      "enum": [
        "open",
        "style_constrained",
        "structure_constrained",
        "convergent"
      ]
    },
    "directions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "asset_category": {
            "type": "string",
            "enum": [
              "typography-and-posters",
              "brand-systems-and-identity",
              "editorial-and-covers",
              "events-and-invitations",
              "product-and-food",
              "beauty-and-lifestyle",
              "infographics-and-field-guides",
              "data-and-research-figures",
              "uiux-and-mockups",
              "illustration-and-mediums",
              "photography-and-cinematic",
              "architecture-and-interior",
              "technical-and-scientific"
            ],
            "description": "Deliverable category shared by the whole portfolio."
          },
          "design_thesis": {
            "type": "string",
            "minLength": 1
          },
          "objective_strategy": {
            "type": "string",
            "minLength": 1
          },
          "direction_decisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "axis": {
                  "type": "string",
                  "enum": [
                    "concept",
                    "composition",
                    "palette",
                    "typography",
                    "image_making",
                    "visual_language"
                  ]
                },
                "decision": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "axis",
                "decision"
              ]
            }
          },
          "implementation_freedom": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "portfolio_role": {
            "type": "string",
            "minLength": 1
          },
          "style_anchors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Short descriptive phrases naming the visual language; not a list of labels."
          }
        },
        "required": [
          "label",
          "asset_category",
          "design_thesis",
          "objective_strategy",
          "direction_decisions",
          "implementation_freedom",
          "portfolio_role"
        ]
      }
    }
  },
  "required": [
    "planning_mode",
    "directions"
  ]
}
