{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReversePrompt",
  "description": "A reusable (positive, negative) prompt pair extracted from an image.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "positive_prompt": {"type": "string", "minLength": 1},
    "negative_prompt": {"type": "string"}
  },
  "required": ["positive_prompt", "negative_prompt"]
}
