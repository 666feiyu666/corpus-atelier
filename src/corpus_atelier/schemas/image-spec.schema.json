{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "communication_objective": {"type": "string"},
    "audience_and_context": {"type": "string"},
    "visible_copy": {
      "type": "array",
      "items": {"type": "string"}
    },
    "subject_and_scene": {
      "type": "string",
      "description": "Unambiguous rendering instructions for subject identity, count, ownership, part-whole continuity, pose, contact, and the scene as one coherent image."
    },
    "composition": {"type": "string"},
    "typography": {"type": "string"},
    "visual_treatment": {"type": "string"},
    "allowed_variation": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_asset_placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {"type": "string", "pattern": "^required-[0-9]{2}$"},
          "left": {"type": "number", "minimum": 0, "maximum": 1},
          "top": {"type": "number", "minimum": 0, "maximum": 1},
          "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        },
        "required": ["asset_id", "left", "top", "width", "height"]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "communication_objective",
    "audience_and_context",
    "visible_copy",
    "subject_and_scene",
    "composition",
    "typography",
    "visual_treatment",
    "allowed_variation",
    "required_asset_placements",
    "exclusions"
  ]
}
