{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "setting": {"type": "string"},
    "exact_copy": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "preferences": {"type": "array", "items": {"type": "string"}},
    "reference_mode": {
      "type": "string",
      "enum": ["style_grounded", "style_inspired"],
      "description": "Explicit reference relationship. Routing is deterministic when present."
    },
    "reference_scope": {
      "type": "string",
      "enum": ["retrieved_snapshot_images"],
      "description": "Top-ranked complete visual references selected from the snapshot."
    },
    "reference_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Number of ranked reference images used for planning and generation."
    }
  },
  "required": ["topic", "purpose", "audience", "setting", "exact_copy", "constraints", "preferences"],
  "dependentRequired": {
    "reference_mode": ["reference_scope", "reference_count"],
    "reference_scope": ["reference_mode", "reference_count"],
    "reference_count": ["reference_mode", "reference_scope"]
  }
}
