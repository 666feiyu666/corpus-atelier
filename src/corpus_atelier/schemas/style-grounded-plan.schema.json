{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {"const": "style_grounded"},
    "summary": {"type": "string", "minLength": 1},
    "style_invariants": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence_ids": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "application": {"type": "string", "minLength": 1}
        },
        "required": ["claim", "evidence_ids", "application"]
      }
    },
    "allowed_variations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "content_mapping_rules": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "work_specific_features_to_exclude": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "human_review_questions": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "required": [
    "mode", "summary", "style_invariants", "allowed_variations",
    "content_mapping_rules", "work_specific_features_to_exclude",
    "human_review_questions"
  ]
}
