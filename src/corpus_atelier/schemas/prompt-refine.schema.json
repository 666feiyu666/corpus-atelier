{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptRefinement",
  "description": "One comparison between a source image and a generated result, with a complete replacement prompt.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reply": {"type": "string", "minLength": 1, "maxLength": 8000},
    "discrepancies": {
      "type": "array",
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "proposed_prompt": {"type": ["string", "null"], "maxLength": 8000}
  },
  "required": ["reply", "discrepancies", "proposed_prompt"]
}
