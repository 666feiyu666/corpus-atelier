{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "setting": {"type": "string"},
    "exact_copy": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "preferences": {"type": "array", "items": {"type": "string"}},
    "reference_mode": {
      "type": "string",
      "enum": ["style_grounded", "style_inspired"],
      "description": "Explicit reference relationship. Routing is deterministic when present."
    },
    "reference_scope": {
      "type": "string",
      "enum": ["all_snapshot_images"],
      "description": "Complete visual references supplied to the reference-planning model."
    }
  },
  "required": ["topic", "purpose", "audience", "setting", "exact_copy", "constraints", "preferences"],
  "dependentRequired": {
    "reference_mode": ["reference_scope"],
    "reference_scope": ["reference_mode"]
  }
}
